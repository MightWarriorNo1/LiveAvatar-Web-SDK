{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "LIVEAVATAR_API_KEY",
    "LIVEAVATAR_API_URL",
    "LIVEAVATAR_AVATAR_ID",
    "LIVEAVATAR_VOICE_ID",
    "LIVEAVATAR_CONTEXT_ID",
    "LIVEAVATAR_LANGUAGE",
    "ELEVENLABS_API_KEY",
    "OPENAI_API_KEY",
    "GROKAI_API_KEY",
    "LLM_PROVIDER",
    "ELEVENLABS_VOICE_ID",
    "RATE_LIMIT_START_SESSION_MAX",
    "RATE_LIMIT_START_SESSION_WINDOW_MS",
    "RATE_LIMIT_ANALYZE_IMAGE_MAX",
    "RATE_LIMIT_ANALYZE_IMAGE_WINDOW_MS",
    "RATE_LIMIT_ANALYZE_VIDEO_MAX",
    "RATE_LIMIT_ANALYZE_VIDEO_WINDOW_MS",
    "RATE_LIMIT_API_CALL_MAX",
    "RATE_LIMIT_API_CALL_WINDOW_MS",
    "DAILY_MAX_SESSIONS",
    "DAILY_MAX_API_CALLS",
    "DAILY_MAX_DURATION_MINUTES",
    "HOURLY_MAX_SESSIONS",
    "HOURLY_MAX_API_CALLS",
    "HOURLY_MAX_DURATION_MINUTES",
    "MAX_SESSION_DURATION_MINUTES",
    "MAX_SESSION_AUTO_RESTARTS",
    "MAX_SESSIONS_PER_DAY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "lib/**",
        "dist/**"
      ],
      "env": [
        "LIVEAVATAR_API_KEY",
        "LIVEAVATAR_API_URL",
        "LIVEAVATAR_AVATAR_ID",
        "LIVEAVATAR_VOICE_ID",
        "LIVEAVATAR_CONTEXT_ID",
        "LIVEAVATAR_LANGUAGE",
        "ELEVENLABS_API_KEY",
        "OPENAI_API_KEY",
        "GROKAI_API_KEY",
        "LLM_PROVIDER",
        "ELEVENLABS_VOICE_ID",
        "RATE_LIMIT_START_SESSION_MAX",
        "RATE_LIMIT_START_SESSION_WINDOW_MS",
        "RATE_LIMIT_ANALYZE_IMAGE_MAX",
        "RATE_LIMIT_ANALYZE_IMAGE_WINDOW_MS",
        "RATE_LIMIT_ANALYZE_VIDEO_MAX",
        "RATE_LIMIT_ANALYZE_VIDEO_WINDOW_MS",
        "RATE_LIMIT_API_CALL_MAX",
        "RATE_LIMIT_API_CALL_WINDOW_MS",
        "DAILY_MAX_SESSIONS",
        "DAILY_MAX_API_CALLS",
        "DAILY_MAX_DURATION_MINUTES",
        "HOURLY_MAX_SESSIONS",
        "HOURLY_MAX_API_CALLS",
        "HOURLY_MAX_DURATION_MINUTES",
        "MAX_SESSION_DURATION_MINUTES",
        "MAX_SESSION_AUTO_RESTARTS",
        "MAX_SESSIONS_PER_DAY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": [
        "LIVEAVATAR_API_KEY",
        "LIVEAVATAR_API_URL",
        "LIVEAVATAR_AVATAR_ID",
        "LIVEAVATAR_VOICE_ID",
        "LIVEAVATAR_CONTEXT_ID",
        "LIVEAVATAR_LANGUAGE",
        "ELEVENLABS_API_KEY",
        "OPENAI_API_KEY",
        "GROKAI_API_KEY",
        "LLM_PROVIDER",
        "ELEVENLABS_VOICE_ID",
        "RATE_LIMIT_START_SESSION_MAX",
        "RATE_LIMIT_START_SESSION_WINDOW_MS",
        "RATE_LIMIT_ANALYZE_IMAGE_MAX",
        "RATE_LIMIT_ANALYZE_IMAGE_WINDOW_MS",
        "RATE_LIMIT_ANALYZE_VIDEO_MAX",
        "RATE_LIMIT_ANALYZE_VIDEO_WINDOW_MS",
        "RATE_LIMIT_API_CALL_MAX",
        "RATE_LIMIT_API_CALL_WINDOW_MS",
        "DAILY_MAX_SESSIONS",
        "DAILY_MAX_API_CALLS",
        "DAILY_MAX_DURATION_MINUTES",
        "HOURLY_MAX_SESSIONS",
        "HOURLY_MAX_API_CALLS",
        "HOURLY_MAX_DURATION_MINUTES",
        "MAX_SESSION_DURATION_MINUTES",
        "MAX_SESSION_AUTO_RESTARTS",
        "MAX_SESSIONS_PER_DAY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "env": [
        "LIVEAVATAR_API_KEY",
        "LIVEAVATAR_API_URL",
        "LIVEAVATAR_AVATAR_ID",
        "LIVEAVATAR_VOICE_ID",
        "LIVEAVATAR_CONTEXT_ID",
        "LIVEAVATAR_LANGUAGE",
